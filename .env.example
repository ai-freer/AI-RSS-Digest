# Delivery channel config (only required when using scripts/delivery.js)
#
# Global retry options (optional)
# DELIVERY_RETRIES=3
# DELIVERY_BASE_DELAY_MS=800
# DELIVERY_MAX_DELAY_MS=5000
#
# ---- Email (choose one mode) ----
# EMAIL_MODE=resend
# EMAIL_FROM=RSS Digest <digest@yourdomain.com>
# EMAIL_TO=you@example.com,team@example.com
#
# Mode A: Resend API (recommended, no extra dependency)
# RESEND_API_KEY=re_xxxx
#
# Mode B: SMTP (requires: npm install nodemailer)
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your_email@qq.com
# SMTP_PASS=your_app_password
#
# ---- Feishu ----
# FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxx
# FEISHU_WEBHOOK_ID=xxxx
#
# ---- DingTalk ----
# DINGTALK_ACCESS_TOKEN=xxxx
# DINGTALK_SECRET=SECxxxx
#
# ---- WeCom ----
# WECOM_KEY=xxxx
# WECOM_MAX_BYTES=2048
#
# ---- WhatsApp ----
# WHATSAPP_ACCESS_TOKEN=EA...
# WHATSAPP_PHONE_NUMBER_ID=1234567890
# WHATSAPP_RECIPIENT_PHONE=+8613800000000
# WHATSAPP_MAX_CHARS=4096
